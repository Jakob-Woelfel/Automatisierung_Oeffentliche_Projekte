{
  "name": "automatisierung-oeffentliche-projekte",
  "version": "1.0.0",
  "description": "Pipeline for processing German public project contract PDFs (Drittmittelverträge)",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "web": "tsx src/web/server.ts",
    "api-connect": "tsx src/api_connect.ts",
    "build": "tsc",
    "test": "vitest run",
    "start:prod": "node dist/main.js",
    "verify-deps": "pnpm install --frozen-lockfile"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fflate": "^0.8.3",
    "openai": "^4.52.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
