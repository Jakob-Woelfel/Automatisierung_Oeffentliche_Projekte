# API key for your Open Web UI instance
OPENWEBUI_API_KEY=your-open-web-ui-key-here
# OpenAI-compatible base URL — Open Web UI's Ollama passthrough
# (the SDK appends /chat/completions)
OPENWEBUI_BASE_URL=https://fcb-wi.fit.fraunhofer.de/ollama/v1
# Optional: port for the local web UI (`pnpm web`). Default: 3000
# PORT=3000
